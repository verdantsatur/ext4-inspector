<div class="cmd-section">
  <h4>Serve the UI locally</h4>
  <div class="cmd-block"><span class="cmd-comment"># Start local web server from project root</span>
python3 -m http.server 8080

<span class="cmd-comment"># Then open in browser:</span>
http://localhost:8080/ui/index.html</div>
</div>

<div class="cmd-section">
  <h4>Install dependencies (Ubuntu / Debian)</h4>
  <div class="cmd-block">sudo apt install e2fsprogs xxd python3 coreutils</div>
</div>`;
}

// ── Tab switching ──────────────────────────────────────────────
function switchTab(t) {
  ['hex','inode','blockmap','sb','cmd'].forEach(id=>{
    const el=$(id+'-wrap')||$('cmd-wrap');
    if($( id+'-wrap')) $(id+'-wrap').style.display=id===t?'block':'none';
    if($(id+'-wrap')&&id==='hex') $(id+'-wrap').style.display=id===t?'block':'none';
    const tab=$('tab-'+id);
    if(tab) tab.classList.toggle('active',id===t);
  });
  if(t==='cmd') $('cmd-wrap').style.display='block';
  // Specifically handle display flex for hex (it's a table)
  if($('hex-wrap')) $('hex-wrap').style.display=t==='hex'?'block':'none';
}

// ── Theme system ───────────────────────────────────────────────
const THEMES = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'];
const DAY_NAMES = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'];

function setTheme(name) {
  document.documentElement.setAttribute('data-theme', name);
  // Update active pill
  document.querySelectorAll('.th-pill').forEach(p => {
    p.classList.toggle('active', p.dataset.theme === name);
  });
  // Persist
  try { localStorage.setItem('ext4_theme', name); } catch(e){}
  // Update toolbar title color
  const accent = getComputedStyle(document.documentElement).getPropertyValue('--th-accent').trim();
  const h1 = document.querySelector('#toolbar h1');
  if(h1 && accent) h1.style.color = accent;
}

function initTheme() {
  // Try saved preference first
  let saved = null;
  try { saved = localStorage.getItem('ext4_theme'); } catch(e){}
  // Fall back to today's day of week
  const todayTheme = DAY_NAMES[new Date().getDay()];
  const theme = (saved && THEMES.includes(saved)) ? saved : todayTheme;
  setTheme(theme);
}

initTheme();

