// ── Startup: detect Chrome on file:// and show a gentle notice
(function() {
  if(window.location.protocol !== 'file:') return;
  const isChromium = !!window.chrome || /Chrome/.test(navigator.userAgent);
  if(!isChromium) return;
  // Nudge user toward paste mode or python server
  const hint = document.createElement('div');
  hint.style.cssText = [
    'position:absolute','top:60px','right:12px',
    'background:#FAEEDA','color:#633806',
    'border:1px solid #EF9F27','border-radius:8px',
    'padding:8px 14px','font-size:11px',
    'font-family:var(--font-sans,sans-serif)',
    'max-width:280px','z-index:50','line-height:1.5',
  ].join(';');
  hint.innerHTML = '<b>Chrome tip:</b> To load scan JSON files, ' +
    'use <b>Paste JSON</b> or serve via ' +
    '<code>python3 -m http.server 8080</code>. ' +
    'Firefox has no such restriction. ' +
    '<span onclick="this.parentNode.remove()" ' +
    'style="cursor:pointer;float:right;margin-left:8px">✕</span>';
  // Only show if body exists
  setTimeout(() => {
    if(document.body) document.body.appendChild(hint);
    setTimeout(() => { if(hint.parentNode) hint.remove(); }, 8000);
  }, 1000);
})();

// Init tabs hidden until a panel is shown
['hex-wrap','inode-wrap','blockmap-wrap','sb-wrap'].forEach(id=>{
  const el=$(id); if(el) el.style.display='none';
});
$('cmd-wrap').style.display='none';

// ── iOS Paste Modal ────────────────────────────────────────────
let pasteValidJSON = null;
let autoLoadTimer = null;

function openPasteModal() {
  document.getElementById('paste-overlay').classList.add('open');
  // Focus textarea after short delay (important for iOS)
  setTimeout(() => {
    const ta = document.getElementById('paste-area');
    if(ta) ta.focus();
  }, 200);
}

function closePasteModal() {
  document.getElementById('paste-overlay').classList.remove('open');
  pasteValidJSON = null;
  document.getElementById('paste-area').value = '';
  document.getElementById('paste-status').textContent = '';
  document.getElementById('paste-status').className = '';
  document.getElementById('paste-load-btn').disabled = true;
  if(autoLoadTimer) clearTimeout(autoLoadTimer);
}

function overlayClick(e) {
  if(e.target === document.getElementById('paste-overlay')) closePasteModal();
}

function validatePaste(text) {
  const status = document.getElementById('paste-status');
  const btn = document.getElementById('paste-load-btn');
  pasteValidJSON = null;
  if(autoLoadTimer) clearTimeout(autoLoadTimer);

  const trimmed = text.trim();
  if(!trimmed) {
    status.textContent = '';
    status.className = '';
    btn.disabled = true;
    return;
  }

  // Quick pre-check before full parse
  if(!trimmed.startsWith('{')) {
    status.textContent = '✗ Not valid JSON — should start with {';
    status.className = 'err';
    btn.disabled = true;
    return;
  }

  try {
    const parsed = JSON.parse(trimmed);

    // Validate it looks like our format
    if(!parsed.tree) {
      status.textContent = '✗ JSON loaded but missing "tree" field — is this an fs_export.json file?';
      status.className = 'err';
      btn.disabled = true;
      return;
    }

    // Success
    pasteValidJSON = parsed;
    const fileCount = parsed.fileCount || '?';
    const scanTarget = parsed.scanTarget || 'unknown';
    const scanTime = parsed.scanTime || '';
    status.textContent = '✓ Valid scan data — ' + fileCount + ' items from "' + scanTarget + '" ' + scanTime;
    status.className = 'ok';
    btn.disabled = false;

    // Auto-load after 1.2 seconds if still valid (convenience for iOS paste)
    autoLoadTimer = setTimeout(() => {
      if(pasteValidJSON) loadPasted();
    }, 1200);

  } catch(e) {
    // Try to give a helpful location hint
    const msg = e.message || '';
    const posMatch = msg.match(/position (\d+)/);
    if(posMatch) {
      const pos = parseInt(posMatch[1]);
      const around = trimmed.substring(Math.max(0,pos-20), pos+20);
      status.textContent = '✗ JSON parse error near: …' + around + '…';
    } else {
      status.textContent = '✗ Invalid JSON: ' + msg.slice(0,80);
    }
    status.className = 'err';
    btn.disabled = true;
  }
}

function loadPasted() {
  if(!pasteValidJSON) return;
  if(autoLoadTimer) clearTimeout(autoLoadTimer);
  fsData = pasteValidJSON;
  const src = pasteValidJSON.scanTarget || 'pasted data';
  document.getElementById('load-label').textContent = '📋 ' + src;
  closePasteModal();
  initFS();
}

// ── Clipboard auto-detect on modal open (desktop convenience) ──
// On desktop browsers, check clipboard when modal opens
async function tryClipboard() {
  try {
    if(navigator.clipboard && navigator.clipboard.readText) {
      const text = await navigator.clipboard.readText();
      if(text && text.trim().startsWith('{') && text.includes('"tree"')) {
        document.getElementById('paste-area').value = text;
        validatePaste(text);
      }
    }
  } catch(e) {
    // Clipboard permission denied — that's fine, user pastes manually
  }
}

</script>
</body>
</html>
