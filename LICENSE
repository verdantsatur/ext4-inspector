<span class="cmd-comment"># Scan a mounted USB drive</span>
./scripts/fs_bridge.sh --mount /mnt/usb

<span class="cmd-comment"># Scan a disk partition (needs sudo)</span>
sudo ./scripts/fs_bridge.sh --partition /dev/sdb1

<span class="cmd-comment"># Scan with options</span>
./scripts/fs_bridge.sh --folder ~/Documents --max-files 10000 --no-hex</div>
  <p class="cmd-note">Output: data/fs_export.json — load this file using the button above.</p>
</div>

<div class="cmd-section">
  <h4>Step 2 — Wipe slack space (real mode, Linux only)</h4>
  <div class="cmd-block"><span class="cmd-comment"># Dry run — see what would be wiped (safe)</span>
./scripts/ext4_wipe_slack.sh --dry-run --folder ~/Documents

<span class="cmd-comment"># Wipe slack on one file</span>
./scripts/ext4_wipe_slack.sh --file ~/Documents/resume.pdf

<span class="cmd-comment"># Wipe entire folder (3-pass DoD 5220.22-M style)</span>
./scripts/ext4_wipe_slack.sh --folder ~/Documents --passes 3

<span class="cmd-comment"># Wipe from a list of files</span>
./scripts/ext4_wipe_slack.sh --list files_to_wipe.txt</div>
  <p class="cmd-note">⚠ Real wipe modifies your disk. Always --dry-run first. Works on any Linux filesystem.</p>
